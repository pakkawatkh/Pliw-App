---
import { withBase } from '../utils/paths';

interface Props {
  variant: 'home' | 'detail';
  activePage?: 'home' | 'about';
  appName?: string;
  appSlug?: string;
  appIcon?: string;
}

const {
  variant,
  activePage = 'home',
  appName = 'Pliw App',
  appSlug = '',
  appIcon = 'assets/favicon.svg',
} = Astro.props;
const homeUrl = withBase('');
const aboutUrl = withBase('about/');
const isAbout = activePage === 'about';
---

<header class="site-header">
  <div class:list={['container', variant === 'detail' && 'container--detail', 'nav-inner']}>
    {
      variant === 'home' ? (
        <>
          <a href={homeUrl} class="brand-logo">
            <img
              src={withBase('assets/favicon.svg')}
              alt="Pliw App"
              width="32"
              height="32"
              class="brand-icon"
            />
            <span>Pliw App</span>
          </a>

          <nav aria-label="Primary">
            <ul class="nav-links">
              <li>
                <a href={isAbout ? `${homeUrl}#apps` : '#apps'} data-nav-filter={isAbout ? undefined : 'app'}>
                  Apps
                </a>
              </li>
              <li>
                <a
                  href={isAbout ? `${homeUrl}#extensions` : '#extensions'}
                  data-nav-filter={isAbout ? undefined : 'extension'}
                >
                  Extensions
                </a>
              </li>
              <li>
                <a href={aboutUrl} aria-current={isAbout ? 'page' : undefined}>About</a>
              </li>
            </ul>
          </nav>

          <a
            href="https://github.com/pakkawatkh/public"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-nav"
          >
            <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.26 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>GitHub</span>
          </a>
        </>
      ) : (
        <>
          <a href={withBase(`${appSlug}/`)} class="brand-logo">
            <img
              src={withBase(appIcon)}
              alt={`${appName} Icon`}
              width="32"
              height="32"
              class="brand-icon"
            />
            <span>{appName}</span>
          </a>

          <nav class="nav-right" aria-label="Page navigation">
            <a href="#preview" class="nav-link">Preview</a>
            <a href="#install" class="nav-link">Install</a>
            <a href={homeUrl} class="nav-link">← All Apps</a>
          </nav>
        </>
      )
    }
  </div>
</header>
