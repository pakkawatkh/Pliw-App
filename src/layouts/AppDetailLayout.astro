---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import QuickInstall from '../components/QuickInstall';
import type { AppEntry } from '../data/types';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
---

<BaseLayout
  title={app.seoTitle}
  description={app.seoDescription}
  faviconPath={app.iconRelPath}
  appSlug={app.slug}
>
  <SiteHeader
    variant="detail"
    appName={app.name}
    appSlug={app.slug}
    appIcon={app.iconRelPath}
  />

  <main class="container container--detail">
    <section class="detail-hero">
      <img src={app.iconUrl} alt={app.name} width="84" height="84" class="hero-icon" />
      <h1>{app.name}</h1>
      <p class="subtitle">{app.description}</p>
      <div class="actions">
        <a href={app.downloadUrl} download class="btn btn-primary">
          Download {app.downloadType} ({app.versionTag} · {app.fileSize})
        </a>
        <a
          href={app.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          GitHub
        </a>
      </div>
      <div class="compat-strip">
        <span class="compat-pill">
          {
            app.category === 'app' ? (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.64-.78 1.08-1.86.96-2.94-.93.04-2.05.62-2.71 1.4-.58.68-1.1 1.78-.96 2.84 1.04.08 2.07-.52 2.71-1.3z" />
              </svg>
            ) : (
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            )
          }
          <span>{app.compatibilityPill}</span>
        </span>
      </div>
    </section>

    <section class="preview-section" id="preview">
      <slot />
    </section>

    <section class="install-box" id="install">
      <QuickInstall
        client:load
        appName={app.name}
        category={app.category}
        quickInstall={app.quickInstall}
      />
    </section>
  </main>

  <SiteFooter detail />
</BaseLayout>
