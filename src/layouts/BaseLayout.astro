---
import '../styles/tokens.css';
import { DEFAULT_OG_IMAGE, SITE_ORIGIN, withBase } from '../utils/paths';
import type { AppSlug } from '../data/types';

interface Props {
  title: string;
  description?: string;
  faviconPath?: string;
  appSlug?: AppSlug;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Open-source macOS productivity utilities and Chromium browser extensions by Pakkawat.k, including Monkey Tools, Pliw Collage, Pliw Click, Pliw Scroll, and Pliw Geo.',
  faviconPath,
  appSlug,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_ORIGIN).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      faviconPath ? (
        <link rel="icon" type="image/png" href={withBase(faviconPath)} />
      ) : (
        <>
          <link rel="icon" type="image/svg+xml" href={withBase('assets/favicon.svg')} />
          <link rel="icon" type="image/png" sizes="32x32" href={withBase('assets/favicon-32.png')} />
          <link rel="icon" type="image/png" href={withBase('assets/favicon.png')} />
        </>
      )
    }

    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={DEFAULT_OG_IMAGE} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-app={appSlug}>
    <div class="ambient-glow" aria-hidden="true"></div>
    <slot />
  </body>
</html>
